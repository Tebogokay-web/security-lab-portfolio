// Purpose: one IP failing against many different users (password spray)
// Table: SigninLogs | MITRE: Credential Access (T1110.003)
// 50126 = invalid username or password, 50053 = account locked
// Test: needs several test users; lower the threshold (Users >= 3) in a small lab
SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType in ("50126", "50053")
| summarize Users = dcount(UserPrincipalName), Attempts = count() by IPAddress
| where Users >= 10
| order by Users desc
