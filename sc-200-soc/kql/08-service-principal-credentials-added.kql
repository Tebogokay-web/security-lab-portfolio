// Purpose: credentials added to an app/service principal (persistence)
// Table: AuditLogs | MITRE: Persistence (T1098.001)
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName has_any ("Add service principal credentials", "Certificates and secrets management")
| project TimeGenerated, OperationName, Result, InitiatedBy, TargetResources
| order by TimeGenerated desc
