// Purpose: who was added to a directory role recently (privilege escalation)
// Table: AuditLogs | MITRE: Privilege Escalation (T1098)
// Test: assign a role to a test user in Entra ID, then run
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName has "Add member to role"
| project TimeGenerated, OperationName, Result, InitiatedBy, TargetResources
| order by TimeGenerated desc
